# Exemple public : aucune vraie valeur secrète dans ce fichier.
# Copier sans écraser vers secrets.toml, puis compléter localement.
# Procédure : docs/CONNEXION_GOOGLE.md

[auth]
redirect_uri = "http://localhost:8502/oauth2callback"
cookie_secret = "REMPLACER_PAR_UN_SECRET_ALEATOIRE_GENERE_LOCALEMENT"

[auth.google]
client_id = "REMPLACER_PAR_LE_CLIENT_ID_GOOGLE.apps.googleusercontent.com"
client_secret = "REMPLACER_PAR_LE_CLIENT_SECRET_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email", prompt = "select_account" }

# Ne pas ajouter expose_tokens ou de scope Gmail/Drive.
# Ce fichier active uniquement l'identification Google pour un profil Sed Lex.
