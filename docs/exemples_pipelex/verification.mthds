# Diagnostic de configuration, sans recherche web ni données personnelles.
# `pipelex validate bundle ...` et `pipelex run bundle ... --dry-run` : sans appel IA.
# L'exécution sans --dry-run utilise les crédits OpenAI de la clé configurée.
domain = "verification_reperes"
main_pipe = "verifier_connexion"

[pipe.verifier_connexion]
type = "PipeLLM"
description = "Vérifier un appel texte Pipelex vers OpenAI"
output = "Text"
model = { model = "gpt-4o-mini", temperature = 0.0, max_tokens = 64 }
prompt = "Réponds uniquement avec cette phrase : Connexion Pipelex et OpenAI opérationnelle."
