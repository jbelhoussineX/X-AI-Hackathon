# Copier en .env et renseigner les valeurs uniquement sur sa machine.
# .env reste privé ; ne jamais y mettre une clé dans un commit.

# Parcours recommandé : moteur Pipelex local + API OpenAI.
OPENAI_API_KEY=
PIPELEX_EXECUTION_MODE=local
ENABLE_PIPELEX_CALLS=false
DO_NOT_TRACK=1

# Alternative réservée aux comptes ayant un accès à l’API Pipelex hébergée.
# Choisir explicitement PIPELEX_EXECUTION_MODE=hosted pour l’utiliser.
PIPELEX_API_KEY=
