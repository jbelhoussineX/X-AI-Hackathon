# Copier ce fichier en .env et saisir les valeurs LOCALEMENT. Ne jamais le partager.
DUST_API_KEY=
DUST_WORKSPACE_ID=
DUST_AGENT_ID=
DUST_TIMEOUT_SECONDS=120

# Pipelex local + OpenAI. Les exports Sénat/Assemblée ne nécessitent aucune clé.
OPENAI_API_KEY=
POLITICAL_DATA_SOURCE=official
# Valeur web : ancien parcours de recherche web OpenAI, 3 à 4 appels de modèle.
# Les variables ci-dessous sont historiques et inutilisées par le parcours local.
PIPELEX_API_KEY=
GRADIUM_API_KEY=
JINKO_API_KEY=
DATABASE_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000
