# Copier en .env, saisir les valeurs localement. Ne jamais committer .env.
OPENAI_API_KEY=
PIPELEX_API_KEY=
ENABLE_PIPELEX_CALLS=false
# hosted : API Pipelex ; local : moteur Pipelex local et API OpenAI
PIPELEX_EXECUTION_MODE=hosted
# official : inventaires Sénat/Assemblée ; web : recherche IA optionnelle
POLITICAL_DATA_SOURCE=official
GRADIUM_API_KEY=
JINKO_API_KEY=
DATABASE_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000
